# Generate a unique value: python -c "import secrets; print(secrets.token_urlsafe(48))"
CODECOLLAB_SECRET_KEY=
CODECOLLAB_DATABASE_PATH=./data/codecollab.sqlite3
CODECOLLAB_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Public frontend configuration, never put a signing key in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_API_URL=http://localhost:8000
